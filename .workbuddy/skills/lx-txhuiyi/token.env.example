# 腾讯会议 Skill（lx-txhuiyi）凭证模板
#
# 使用步骤：
#   1. 访问 https://meeting.tencent.com/ai-skill 获取属于你自己的 Token
#      （Token 与个人账号绑定，不能与他人共用）
#   2. 复制本文件：cp token.env.example token.env
#   3. 把 Token 填进 token.env 的引号内
#   4. 收紧权限：chmod 600 token.env
#   5. 确认 shell 启动脚本中已加载它（见 SKILL.md「安装」一节）
export TENCENT_MEETING_TOKEN=""
